rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // FamilyOS rules allowing authenticated users or family client access
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    match /reminders/{reminderId} {
      allow read: if true;
      allow write: if true;
    }

    match /documents/{documentId} {
      allow read: if true;
      allow write: if true;
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    match /memories/{memoryId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
